<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Heart rate during a workout. Wear OS 5 and older ask for BODY_SENSORS; Wear OS 6 (Android 16) replaced it
         with the health permission below. Asked when he first starts a workout on the watch, never at install. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Steps and distance on foot. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- A workout keeps running with the screen off, as a foreground service of the health type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The buzz when a rest ends. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Services lives in its own package; without this Android 11+ can hide it from the app. -->
    <queries>
        <package android:name="com.google.android.wearable.healthservices" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/WatchTheme">

        <!-- Not standalone: it needs the phone app, which holds the plan and the log. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Today's session, written by the phone app (path /pt/today). -->
        <service
            android:name=".TodayListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/pt/" />
            </intent-filter>
        </service>
    </application>
</manifest>
