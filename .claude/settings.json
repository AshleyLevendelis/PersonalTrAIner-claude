{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 60,
            "statusMessage": "Typechecking (src/ only)..."
          }
        ]
      }
    ]
  }
}
